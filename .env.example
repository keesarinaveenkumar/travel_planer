# Trip planner service — any chat-completions compatible endpoint (all three required)
PLANNER_API_KEY=
PLANNER_BASE_URL=https://your-provider.example/v1
PLANNER_MODEL=your-model-name

# Hotels & place photos (Google Places API "New" must be enabled)
GOOGLE_MAPS_API_KEY=    
# Map embeds in the itinerary (optional; falls back to keyless embeds)
GOOGLE_MAPS_BROWSER_KEY=

# Optional: a long random string. If you leave this out, one is generated and kept in .secret_key
# SECRET_KEY=

# Optional: live "what travellers spend" articles on the plan page, from Google Programmable Search.
# Create a search engine that searches the whole web, enable the Custom Search API, then fill in both.
# Without these the page still offers a "Search Google for … budgets" link — nothing breaks.
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_CX=
